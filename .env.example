# ---------------------------------------------------------------------------
# ForgeOptima AI — environment configuration
# Copy to `.env` at the repository root (or backend/.env) and adjust.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="ForgeOptima AI"
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Local development default (no server required):
# DATABASE_URL=sqlite:///./forgeoptima.db
# PostgreSQL (production / Render):
# DATABASE_URL=postgresql+psycopg://forgeoptima:password@localhost:5432/forgeoptima
DATABASE_URL=sqlite:///./forgeoptima.db

# --- CORS (comma separated) ------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SHAKTHI AI / Ollama ---------------------------------------------------
# Development: local Ollama. Production: a secured inference host with
# authentication and network restrictions — never expose a laptop publicly.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180

# --- Domain ----------------------------------------------------------------
# Grid CO2 emission factor (kg CO2 per kWh). Configurable in the Settings UI.
EMISSION_FACTOR_KG_PER_KWH=0.71
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=240

# --- Frontend (Vite) -------------------------------------------------------
# Leave empty in development to use the Vite proxy.
# VITE_API_BASE_URL=https://forgeoptima-api.onrender.com
