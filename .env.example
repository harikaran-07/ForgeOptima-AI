# ---------------------------------------------------------------------------
# ForgeOptima AI — environment configuration
# Copy to `.env` at the repository root (or backend/.env) and adjust.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="ForgeOptima AI"
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Local development default (no server required):
DATABASE_URL=sqlite:///./forgeoptima.db
# PostgreSQL (production / Vercel Managed PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/forgeoptima?sslmode=require
# POSTGRES_URL=postgres://...

# --- CORS (comma separated) ------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://forge-optima-ai.vercel.app

# --- SHAKTHI AI · Browser Local AI Architecture ----------------------------
# Primary LLM execution runs 100% inside the user's browser via @mlc-ai/web-llm (WebGPU).
# Model: Qwen2.5 3B Instruct (Qwen2.5-3B-Instruct-q4f16_1-MLC)
# No external inference API keys (zero cost, zero cloud token billing).
# No Ollama server installation required for users.
AI_PROVIDER=webllm
AI_MODEL=Qwen2.5-3B-Instruct

# --- Domain ----------------------------------------------------------------
# Grid CO2 emission factor (kg CO2 per kWh). Configurable in the Settings UI.
EMISSION_FACTOR_KG_PER_KWH=0.71
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=240

# --- Frontend (Vite) -------------------------------------------------------
# Leave empty in development to use the Vite proxy.
# VITE_API_BASE_URL=https://forge-optima-ai.vercel.app
